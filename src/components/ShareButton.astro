---
// Deli s prijatelji. Na telefonu odpre sistemski meni za deljenje (Viber, WhatsApp, Messenger …).
// Kjer ga ni (večina računalnikov), pokaže preproste povezave – brez skript tretjih oseb in brez sledenja.
interface Props {
  /** Absolutni URL, ki ga delimo. */
  shareUrl: string;
  text?: string;
  label?: string;
  variant?: 'primary' | 'secondary';
}
const {
  shareUrl,
  text = 'Brezplačno se učim o toplotnih črpalkah – kratke lekcije s kvizi, na telefonu. Pridruži se:',
  label = 'Deli s prijatelji',
  variant = 'secondary',
} = Astro.props;
const id = `deli-${Math.random().toString(36).slice(2, 8)}`;
const enc = encodeURIComponent;
const both = `${text} ${shareUrl}`;
const links = [
  { label: 'Viber', href: `viber://forward?text=${enc(both)}` },
  { label: 'WhatsApp', href: `https://wa.me/?text=${enc(both)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(shareUrl)}` },
  { label: 'E-pošta', href: `mailto:?subject=${enc('Akademija toplotnih črpalk')}&body=${enc(both)}` },
];
---
<div class="share" data-share data-url={shareUrl} data-text={text}>
  <button type="button" class={`btn ${variant === 'secondary' ? 'secondary' : ''} share-btn`} popovertarget={id} data-share-btn>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
    {label}
  </button>
  <div popover id={id} class="share-pop" role="dialog" aria-label="Deli povezavo">
    <p class="share-title">Deli Akademijo TČ</p>
    <div class="share-links">
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>)}
      <button type="button" data-copy>Kopiraj povezavo</button>
    </div>
    <p class="share-status" aria-live="polite" data-status></p>
    <button type="button" class="btn ghost small" popovertarget={id} popovertargetaction="hide">Zapri</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((box) => {
    const url = box.dataset.url!;
    const text = box.dataset.text!;
    const btn = box.querySelector<HTMLButtonElement>('[data-share-btn]')!;
    const status = box.querySelector<HTMLElement>('[data-status]')!;

    // Sistemski meni za deljenje, kjer obstaja – namesto našega okna.
    if (typeof navigator.share === 'function') {
      btn.removeAttribute('popovertarget');
      btn.addEventListener('click', async () => {
        try {
          await navigator.share({ title: 'Akademija toplotnih črpalk', text, url });
        } catch {
          /* uporabnik je zaprl meni */
        }
      });
    }

    box.querySelector('[data-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Povezava je kopirana.';
      } catch {
        status.textContent = url;
      }
    });
  });
</script>

<style>
  .share-btn svg {
    flex: none;
  }
  .share-pop {
    width: min(360px, calc(100vw - 32px));
    margin: auto auto 16px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.25);
  }
  .share-pop::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  .share-title {
    margin: 0 0 12px;
    font-weight: 700;
  }
  .share-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .share-links a,
  .share-links button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .share-links button {
    grid-column: 1 / -1;
  }
  .share-status {
    min-height: 1.5em;
    margin: 10px 0 4px;
    font-size: 0.9rem;
    color: var(--ink-2);
    word-break: break-all;
  }
</style>
