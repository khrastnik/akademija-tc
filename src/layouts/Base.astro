---
import '../styles/global.css';
import { SITE, url, sourceUrl, issueUrl } from '../lib/site.js';
import pkg from '../../package.json';

interface Props {
  title: string;
  description?: string;
  /** Datoteka v repozitoriju, iz katere je stran (za povezavo »Vir«). */
  source?: string;
  updated?: string;
  current?: 'pot' | 'simulator' | 'slovar' | 'ponovitev' | 'izpit';
  /** Široka postavitev (simulator). */
  wide?: boolean;
}
const { title, description = 'Brezplačna, odprta spletna pot od nič do serviserja in diagnostika toplotnih črpalk zrak–voda. Kratke lekcije s kvizi, na telefonu.', source = 'src/pages', updated, current, wide = false } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} · ${SITE.short}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
const nav = [
  { id: 'pot', href: url('pot'), label: 'Pot' },
  { id: 'simulator', href: url('simulator'), label: 'Simulator' },
  { id: 'slovar', href: url('slovar'), label: 'Slovar' },
  { id: 'ponovitev', href: url('ponovitev'), label: 'Ponovitev' },
  { id: 'izpit', href: url('izpit'), label: 'Izpit' },
];
---
<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171411" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Izbrana tema pred prvim izrisom – brez utripa napačne barve.
      try {
        var t = localStorage.getItem('akademija-tc:tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />

    <!-- Predogled povezave pri deljenju (Viber, WhatsApp, Messenger, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Akademija toplotnih črpalk – od nič do serviserja" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#vsebina">Preskoči na vsebino</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>Akademija <span>TČ</span></a>
        <nav class="nav" aria-label="Glavni meni">
          {nav.map((n) => <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Temni način" title="Svetli / temni način">
          <svg class="i-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="i-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/></svg>
        </button>
      </div>
    </header>
    <script is:inline>
      // Svetli / temni način: prva izbira sledi sistemu, nato velja izbira uporabnika.
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        var dark = matchMedia('(prefers-color-scheme: dark)');
        var current = function () { return root.dataset.theme || (dark.matches ? 'dark' : 'light'); };
        var sync = function () {
          var isDark = current() === 'dark';
          btn.setAttribute('aria-label', isDark ? 'Svetli način' : 'Temni način');
          btn.setAttribute('aria-pressed', String(isDark));
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = isDark ? '#171411' : '#f7f3ec'; });
        };
        btn.addEventListener('click', function () {
          var next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('akademija-tc:tema', next); } catch (e) {}
          sync();
        });
        dark.addEventListener('change', sync);
        sync();
      })();
    </script>
    <main id="vsebina" class={wide ? "wrap wide" : "wrap"}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>Ta stran uči razumevanje in diagnostično razmišljanje.</strong> Ne nadomešča uradnega usposabljanja ne spričevala, ki ga zakonodaja zahteva za delo s hladivi. Navodila proizvajalca vedno prevladajo.</p>
        <p class="links">
          {updated && <span>Zadnja sprememba: {updated}</span>}
          <a href={sourceUrl(source)}>Vir na GitHubu</a>
          <a href={issueUrl(title)}>Javi napako</a>
          <a href={`${SITE.repo}/blob/${SITE.branch}/CONTRIBUTING.md`}>Kako pomagati</a>
        </p>
        <p>Koda MIT · vsebina CC BY-NC-SA 4.0 · brez piškotkov, sledenja in analitike · <a href={`${SITE.repo}/blob/${SITE.branch}/CHANGELOG.md`}>različica {pkg.version}</a></p>
      </div>
    </footer>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ swUrl: url('sw.js'), scope: url('') }}>
        // Service worker: stran deluje brez povezave in se ob ponovnem obisku naloži iz predpomnilnika.
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register(swUrl, { scope }).catch(() => {}));
        }
      </script>
    )}
  </body>
</html>
