---
import '../styles/global.css';
import ShareButton from '../components/ShareButton.astro';
import { SITE, url, sourceUrl, issueUrl } from '../lib/site.js';

interface Props {
  title: string;
  description?: string;
  /** Datoteka v repozitoriju, iz katere je stran (za povezavo »Vir«). */
  source?: string;
  updated?: string;
  current?: 'pot' | 'orodja' | 'slovar' | 'ponovitev' | 'izpit';
}
const { title, description = 'Brezplačna, odprta spletna pot od nič do serviserja in diagnostika toplotnih črpalk zrak–voda. Kratke lekcije s kvizi, na telefonu.', source = 'src/pages', updated, current } = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} · ${SITE.short}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(url(''), Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
const nav = [
  { id: 'pot', href: url('pot'), label: 'Pot' },
  { id: 'orodja', href: url('orodja'), label: 'Orodja' },
  { id: 'slovar', href: url('slovar'), label: 'Slovar' },
  { id: 'ponovitev', href: url('ponovitev'), label: 'Ponovitev' },
  { id: 'izpit', href: url('izpit'), label: 'Izpit' },
];
---
<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171411" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />

    <!-- Predogled povezave pri deljenju (Viber, WhatsApp, Messenger, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Akademija toplotnih črpalk – od nič do serviserja" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#vsebina">Preskoči na vsebino</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>Akademija <span>TČ</span></a>
        <nav class="nav" aria-label="Glavni meni">
          {nav.map((n) => <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="vsebina" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-share">
          <p><strong>Poznaš koga, ki ga to zanima?</strong> Akademija je brezplačna za vse.</p>
          <ShareButton shareUrl={homeUrl} />
        </div>
        <p><strong>Ta stran uči razumevanje in diagnostično razmišljanje.</strong> Ne nadomešča uradnega usposabljanja ne spričevala, ki ga zakonodaja zahteva za delo s hladivi. Navodila proizvajalca vedno prevladajo.</p>
        <p class="links">
          {updated && <span>Zadnja sprememba: {updated}</span>}
          <a href={sourceUrl(source)}>Vir na GitHubu</a>
          <a href={issueUrl(title)}>Javi napako</a>
          <a href={`${SITE.repo}/blob/${SITE.branch}/CONTRIBUTING.md`}>Kako pomagati</a>
        </p>
        <p>Koda MIT · vsebina CC BY-NC-SA 4.0 · brez piškotkov, sledenja in analitike.</p>
      </div>
    </footer>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ swUrl: url('sw.js'), scope: url('') }}>
        // Service worker: stran deluje brez povezave in se ob ponovnem obisku naloži iz predpomnilnika.
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register(swUrl, { scope }).catch(() => {}));
        }
      </script>
    )}
  </body>
</html>
