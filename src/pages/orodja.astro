---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site.js';
---
<Base title="Orodja" source="src/pages/orodja.astro" current="orodja">
  <p class="eyebrow">Servisni center</p>
  <h1>Orodja</h1>
  <p class="notice">Ostala orodja so v pripravi. Selijo se iz obstoječega »Servisnega centra TČ« in pridejo na to stran, ko bodo podatki o hladivih preverjeni z virom.</p>
  <ul class="mod-list">
    <li><a class="mod" href={url("simulator")}><span class="num">3D</span><span><h3>3D simulator</h3><p>Kako črpalka deluje, opis delov, načini delovanja in štiri postaje kroga hladiva.</p></span><span class="pill">Odpri →</span></a></li>
    <li><a class="mod" href={url("okvare")}><span class="num">⚠</span><span><h3>Okvare in popravila</h3><p>Zakaj se del pokvari, kako se pokaže in kako se popravi ali zamenja.</p></span><span class="pill">Odpri →</span></a></li>
    <li><a class="mod" href={url("f-plini")}><span class="num">F</span><span><h3>Priprava na izpit F-plini</h3><p>Kategorije, snov, praktični del, izračun CO₂e in vaja.</p></span><span class="pill">Odpri →</span></a></li>
    <li class="mod" data-state="soon"><span class="num">Dx</span><span><h3>Diagnostični program</h3><p>Vnos meritev, izračun veličin, razvrstitev vzorcev, diagnoza s koraki popravila.</p></span><span class="pill">Faza 3</span></li>
    <li class="mod" data-state="soon"><span class="num">?</span><span><h3>Vodnik po simptomih</h3><p>Drevo odločitev od simptoma do vzroka.</p></span><span class="pill">Faza 3</span></li>
    <li><a class="mod" href={url("kode")}><span class="num">E</span><span><h3>Kode napak</h3><p>Daikin, Panasonic, Mitsubishi, Vaillant, Samsung, LG – kaj pomeni in kaj najprej preveriti.</p></span><span class="pill">Odpri →</span></a></li>
    <li><a class="mod" href={url("teren")}><span class="num">🎮</span><span><h3>Teren – igra serviserja</h3><p>Delovni dan, 16 tipičnih okvar, meritve s ceno v minutah, ugled in zaslužek.</p></span><span class="pill">Igraj →</span></a></li>
    <li><a class="mod" href="https://termoteren-servisni-simulator.klemen-hrastnik.chatgpt.site/" target="_blank" rel="noopener"><span class="num">3D</span><span><h3>Termoteren – servisni simulator</h3><p>Diagnostika v 3D na objektu: servisni kovček, meritve, delovni nalogi. Odpre se v novem zavihku.</p></span><span class="pill">Igraj ↗</span></a></li>
    <li><a class="mod" href={url("oprema")}><span class="num">🧰</span><span><h3>Merilna oprema</h3><p>Manometrska baterija, termometri, kleščni ampermeter, vakuumska črpalka … – delujoče naprave z opisom, kaj se meri, kje in kako.</p></span><span class="pill">Odpri →</span></a></li>
    <li><a class="mod" href={url("servis")}><span class="num">DN</span><span><h3>Servisna mapa</h3><p>Primer za 10 strank: delovni nalogi, zapisnik na terenu in poročilo po obisku.</p></span><span class="pill">Odpri →</span></a></li>
    <li><a class="mod" href={url("sh-sc")}><span class="num">SH</span><span><h3>Kalkulator pregrevanja in podhlajevanja</h3><p>R32, R410A in R290 – za diagnostiko z manometri na terenu.</p></span><span class="pill">Odpri →</span></a></li>
  </ul>
</Base>
