---
import Base from '../layouts/Base.astro';
import { loadLessons, loadModules, loadFgasExam, loadCodes } from '../lib/content.js';
import { SITE, url } from '../lib/site.js';
import ShareButton from '../components/ShareButton.astro';

const lessons = loadLessons();
const modules = loadModules();
const first = lessons[0];
const examCount = loadFgasExam().questions.length;
/** slovenska množina: 1 vprašanje, 2 vprašanji, 3–4 vprašanja, 5+ vprašanj (po zadnjih dveh števkah) */
const vprasanj = (n: number) => { const r = n % 100; return r === 1 ? 'vprašanje' : r === 2 ? 'vprašanji' : r === 3 || r === 4 ? 'vprašanja' : 'vprašanj'; };
const codeCount = loadCodes().brands.reduce((s, b) => s + b.codes.length, 0);
---
<Base title={SITE.name} source="src/pages/index.astro">
  <section class="hero">
    <p class="eyebrow">Brezplačno · odprto · na telefonu</p>
    <h1>Od nič do serviserja toplotnih črpalk</h1>
    <p class="lead">Kratke lekcije, igra iz prakse in orodja za teren – vse razloži <em>zakaj</em>.</p>
    <div class="hero-actions">
      <a class="btn big" href={url(`lekcija/${first.id}/`)} data-continue>Začni prvo lekcijo →</a>
      <ShareButton shareUrl={new URL(url(''), Astro.site).href} />
    </div>
    <p class="progress-line muted" data-progress hidden></p>
  </section>

  <h2 class="choose">Kaj danes potrebuješ?</h2>
  <section class="routes">
    <article class="route r-learn">
      <p class="route-tag">📘 Učim se od začetka</p>
      <h3>Razumeti, kako toplotna črpalka deluje</h3>
      <p>Pot v {modules.length} modulih: od toplote iz zraka do diagnostike. Kartice, vaje in kvizi; napačni odgovori se vrnejo v ponovitev.</p>
      <ul class="route-links">
        <li><a href={url('pot')}><strong>Učna pot</strong><span>vsi moduli in napredek</span></a></li>
        <li><a href={url('simulator')}><strong>3D simulator</strong><span>kako deluje, del za delom</span></a></li>
        <li><a href={url('slovar')}><strong>Slovar pojmov</strong><span>vsi strokovni izrazi</span></a></li>
        <li><a href={url('teren')}><strong>Igra Teren</strong><span>vaja diagnostike – po modulih 5–8</span></a></li>
        <li><a href={url('termoteren/')}><strong>Igra 3D</strong><span>servisni simulator – diagnostika na objektu</span></a></li>
      </ul>
    </article>
    <article class="route r-exam">
      <p class="route-tag">🎓 Pripravljam se na izpit</p>
      <h3>Spričevalo za delo s F-plini</h3>
      <p>{examCount} {vprasanj(examCount)} v slogu izpita z razlagami, simulacija izpita z omejenim časom, praktični postopki in izračun CO₂e.</p>
      <ul class="route-links">
        <li><a href={url('f-plini#vprasanja')}><strong>Simulacija izpita</strong><span>51 vprašanj, 90 minut – kot pisni izpit</span></a></li>
        <li><a href={url('f-plini#snov')}><strong>Snov po temah</strong><span>s kljukico »to znam«</span></a></li>
        <li><a href={url('f-plini#izracun')}><strong>Izračun CO₂e</strong><span>in pogostost pregledov tesnosti</span></a></li>
      </ul>
    </article>
    <article class="route r-field">
      <p class="route-tag">🧰 Sem na terenu</p>
      <h3>Hitra pomoč ob napravi</h3>
      <p>Koda na zaslonu, odčitek z manometra, pokvarjen del – pomen, prvi koraki in kdo sme poseg narediti.</p>
      <ul class="route-links">
        <li><a href={url('kode')}><strong>Kode napak</strong><span>{codeCount} kod šestih proizvajalcev</span></a></li>
        <li><a href={url('sh-sc')}><strong>Kalkulator SH/SC</strong><span>R32, R410A, R290</span></a></li>
        <li><a href={url('okvare')}><strong>Okvare in popravila</strong><span>zakaj se pokvari, kako se zamenja</span></a></li>
        <li><a href={url('oprema')}><strong>Merilna oprema</strong><span>naprave, ki jih preizkusiš</span></a></li>
      </ul>
    </article>
  </section>

  <a class="sim-teaser" href={url('teren')}>
    <span class="sim-badge">IGRA</span>
    <strong>Teren – delovni dan serviserja</strong>
    <span>Stranke kličejo, ura teče. Z meritvami poišči vzrok – 16 tipičnih okvar, dve hkrati, letni časi. Po vsakem nalogu izveš, zakaj je diagnoza pravilna.</span>
    <span class="go">Igraj →</span>
  </a>

  <section class="how">
    <h2>Kako se učiš</h2>
    <ol>
      <li><strong>Ena ideja na kartico</strong> – največ 120 besed, nato »Naprej«.</li>
      <li><strong>Vedno »zakaj«</strong> – vsak koncept v 3 do 5 korakih od vzroka do posledice.</li>
      <li><strong>Vaja iz prakse</strong> – v igri meriš, sklepaš in dobiš razlago, ne le točke.</li>
      <li><strong>Brez računa</strong> – napredek ostane v tem brskalniku. Izvoziš ga lahko kot datoteko na strani <a href={url('pot')}>Pot</a>.</li>
    </ol>
  </section>
</Base>

<script>
  import { load } from '../lib/progress';
  const p = load();
  const done = Object.values(p.lessons).filter((l) => l.done).length;
  const btn = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
  if (p.last) {
    btn.textContent = 'Nadaljuj lekcijo →';
    btn.href = btn.href.replace(/lekcija\/[^/]+\/?$/, `lekcija/${p.last}/`);
  }
  if (done > 0) {
    const line = document.querySelector<HTMLElement>('[data-progress]')!;
    line.textContent = `Opravljenih lekcij: ${done} · ${p.xp} XP`;
    line.hidden = false;
  }
</script>

<style>
  .hero {
    padding: 12px 0 20px;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 18px 0 8px;
  }
  .btn.big {
    min-height: 56px;
    padding: 0 26px;
    font-size: 1.1rem;
  }
  .choose {
    margin: 8px 0 12px;
  }
  .routes {
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 16px;
  }
  .route {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--line);
    border-top: 5px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .r-learn {
    border-top-color: var(--low);
  }
  .r-exam {
    border-top-color: var(--ochre);
  }
  .r-field {
    border-top-color: var(--ok);
  }
  .route h3,
  .route p {
    margin: 0;
  }
  .route > p:not(.route-tag) {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .route-tag {
    font-weight: 800;
    font-size: 0.9rem;
  }
  .route-links {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .route-links li {
    max-width: none;
  }
  .route-links a {
    display: grid;
    min-height: 48px;
    align-content: center;
    padding: 6px 10px;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--ink);
    text-decoration: none;
  }
  .route-links a:hover {
    outline: 2px solid var(--accent);
  }
  .route-links span {
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .sim-teaser {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
    padding: 20px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, #2f7fd1 0%, #1f5fa3 45%, #a4502a 100%);
    color: #fff;
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .sim-teaser strong {
    font-size: 1.3rem;
  }
  .sim-teaser .go {
    font-weight: 700;
    margin-top: 4px;
  }
  .sim-badge {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.2);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .trust {
    margin-top: 6px;
  }
  .how {
    margin-top: 28px;
  }
  .how li {
    margin: 8px 0;
  }
</style>
