---
import Base from '../../layouts/Base.astro';
import { loadLessons, loadModules, lessonNumber } from '../../lib/content.js';
import { url } from '../../lib/site.js';

export function getStaticPaths() {
  const lessons = loadLessons();
  const mods = loadModules().filter((m) => lessons.some((l) => l.module === m.id));
  return mods.map((m, i) => ({ params: { id: m.id }, props: { mod: m, lessons: lessons.filter((l) => l.module === m.id), prev: mods[i - 1], next: mods[i + 1] } }));
}
const { mod, lessons, prev, next } = Astro.props;
const minutes = lessons.reduce((s: number, l: any) => s + l.minutes, 0);
const unreviewed = lessons.some((l: any) => !l.reviewed);
---
<Base title={`Modul ${mod.number}: ${mod.title}`} current="pot" source={`content/modules/${mod.dir}`}>
  <nav class="crumbs" aria-label="Drobtine"><a href={url('pot')}>← Učna pot</a></nav>
  <p class="eyebrow">Modul {mod.number} · {mod.phase}</p>
  <h1>{mod.title}</h1>
  {unreviewed && <p class="notice">Vsebina še ni strokovno pregledana.</p>}
  <p><strong>Cilj:</strong> {mod.goal}</p>
  <p class="muted">{lessons.length} lekc. · približno {minutes} min</p>

  <ol class="mod-list">
    {lessons.map((l: any) => (
      <li>
        <a class="mod" href={url(`lekcija/${l.id}/`)} data-lesson={l.id}>
          <span class="num">{lessonNumber(l.id)}</span>
          <span>
            <h3>{l.title}</h3>
            <p>{l.level} · {l.minutes} min</p>
          </span>
          <span class="pill" data-label>Začni</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="muted soon">Naslednje lekcije tega modula so v pripravi.</p>
  <nav class="mod-nav" aria-label="Moduli">
    {prev ? <a href={url(`modul/${prev.id}/`)}><small>← Prejšnji modul</small><span>{prev.number}. {prev.title}</span></a> : <span />}
    {next && <a class="next" href={url(`modul/${next.id}/`)}><small>Naslednji modul →</small><span>{next.number}. {next.title}</span></a>}
  </nav>
</Base>

<script>
  import { load } from '../../lib/progress';
  const p = load();
  document.querySelectorAll<HTMLElement>('[data-lesson]').forEach((a) => {
    const l = p.lessons[a.dataset.lesson!];
    const label = a.querySelector<HTMLElement>('[data-label]')!;
    if (l?.done) {
      a.dataset.state = 'done';
      label.textContent = 'Opravljeno ✓';
    } else if (l) label.textContent = 'Nadaljuj';
  });
</script>

<style>
  .soon {
    margin-top: 16px;
  }
  .crumbs {
    margin-bottom: 4px;
    font-size: 0.95rem;
  }
  .crumbs a {
    display: inline-block;
    padding: 11px 6px;
    margin: 0 -6px;
  }
  .mod-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 24px;
  }
  .mod-nav a {
    display: grid;
    gap: 2px;
    min-height: 64px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .mod-nav a.next {
    text-align: right;
  }
  .mod-nav small {
    color: var(--accent);
    font-weight: 700;
  }
  .mod-nav span {
    font-weight: 600;
    line-height: 1.3;
  }
</style>
